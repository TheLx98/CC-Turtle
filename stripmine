-- stripmine (CC:Tweaked / ATM10) - FINAL (no double-right on resume + torch return/unload/resume)
-- Main tunnel 2-high. Every 3 blocks: side tunnels right+left, 5 long, 2-high.
-- Torch at END of each side tunnel (reliable placement).
-- Auto-refuel.
-- If inventory full: return to start and unload to chest BEHIND start orientation.
-- If chest is full/blocking: STOP and wait (rerun after you fix chest).
-- NEW: If torches (slot 16) run out: go start, unload, STOP and wait. When torches refilled, resume at old position.

-- ================= CONFIG =================
local DEFAULT_LENGTH = 500
local SIDE_EVERY = 3
local SIDE_LEN   = 5

local TORCH_SLOT = 16
local FUEL_SLOT  = 15 -- optional safe slot, not unloaded

local STATE_FILE = "stripmine_state"
-- =========================================

local function log(msg) print("[StripMine] " .. msg) end

-- --------------- STATE -------------------
local function saveState(st)
  local h = fs.open(STATE_FILE, "w")
  h.write(textutils.serialize(st))
  h.close()
end

local function loadState()
  if not fs.exists(STATE_FILE) then return nil end
  local h = fs.open(STATE_FILE, "r")
  local t = textutils.unserialize(h.readAll())
  h.close()
  if type(t) ~= "table" then return nil end
  return t
end

local function resetState()
  if fs.exists(STATE_FILE) then fs.delete(STATE_FILE) end
end

local function migrateState(st)
  -- older versions used 'main'
  if st.mainSteps == nil and type(st.main) == "number" then st.mainSteps = st.main end
  if type(st.mainSteps) ~= "number" then st.mainSteps = 0 end

  if st.mode == nil then st.mode = "MAIN" end
  if st.phase == nil then st.phase = "MAIN" end

  -- sideStep = progress within a side tunnel (optional)
  if type(st.sideStep) ~= "number" then st.sideStep = 0 end

  -- sideStage controls which side is next when in SIDES phase:
  -- "" = not in sides, "R" = do right next, "L" = do left next
  if st.sideStage == nil then st.sideStage = "" end

  return st
end

-- ------------- DIG / MOVE ----------------
local function digForward()
  while turtle.detect() do
    turtle.dig()
    sleep(0.05)
  end
end

local function digUp()
  while turtle.detectUp() do
    turtle.digUp()
    sleep(0.05)
  end
end

local function forward()
  digForward()
  while not turtle.forward() do
    turtle.attack()
    sleep(0.05)
    digForward()
  end
end

local function step2High()
  digForward()
  digUp()
  forward()
  digUp()
end

-- --------------- FUEL --------------------
local function tryRefuelFromSlot(slot)
  if turtle.getItemCount(slot) <= 0 then return false end
  turtle.select(slot)
  if turtle.refuel(0) then
    turtle.refuel(64)
    turtle.select(1)
    local f = turtle.getFuelLevel()
    return (f == "unlimited") or (f > 0)
  end
  turtle.select(1)
  return false
end

local function ensureFuel()
  local f = turtle.getFuelLevel()
  if f == "unlimited" then return end
  if f > 0 then return end

  if tryRefuelFromSlot(FUEL_SLOT) then return end

  for i=1,16 do
    if i ~= TORCH_SLOT and tryRefuelFromSlot(i) then return end
  end

  error("Fuel leer und kein Refuel-Material gefunden. Bitte Fuel nachlegen.")
end

-- ----------- INVENTORY -------------------
local function compactInventory()
  for i=1,16 do
    if turtle.getItemCount(i) > 0 then
      turtle.select(i)
      for j=i+1,16 do
        if turtle.getItemCount(j) > 0 then
          turtle.select(j)
          turtle.transferTo(i)
        end
      end
    end
  end
  turtle.select(1)
end

local function isInventoryFull()
  compactInventory()
  for i=1,16 do
    if turtle.getItemCount(i) == 0 then return false end
  end
  return true
end

-- ---------- HOME MOVE (main line) --------
local function goHome(stepsFromStart)
  -- assumes turtle is on main line facing forward direction
  turtle.turnLeft(); turtle.turnLeft()
  for i=1,stepsFromStart do
    ensureFuel()
    forward()
  end
  turtle.turnLeft(); turtle.turnLeft()
end

local function goBackToWork(stepsFromStart)
  -- from start facing forward direction back to the work position along main line
  for i=1,stepsFromStart do
    ensureFuel()
    step2High()
  end
end

-- ---------- UNLOAD (chest behind start) ---
local function unloadToBackChestOrStop(st)
  log("Entladen in Kiste hinter Start...")

  turtle.turnLeft(); turtle.turnLeft()

  local failed = false
  for i=1,16 do
    if turtle.getItemCount(i) > 0 and i ~= TORCH_SLOT and i ~= FUEL_SLOT then
      turtle.select(i)
      local ok = turtle.drop()
      if (not ok) and turtle.getItemCount(i) > 0 then
        failed = true
      end
    end
  end

  turtle.select(1)
  turtle.turnLeft(); turtle.turnLeft()

  if failed then
    st.mode = "WAIT_CHEST_FULL"
    saveState(st)
    error("Kiste voll/blockiert: Entladen nicht vollständig. Ich bleibe am Start stehen.")
  end
end

-- -------------- TORCH --------------------
local function placeTorchAtSideEnd()
  if turtle.getItemCount(TORCH_SLOT) <= 0 then
    return false
  end

  -- At end: facing solid wall. Step 1 back, face wall, place into air at end cell.
  turtle.turnLeft(); turtle.turnLeft() -- face back to exit
  forward()                             -- step 1 back (dig-safe)
  turtle.turnLeft(); turtle.turnLeft() -- face end wall again

  turtle.select(TORCH_SLOT)
  local ok = turtle.place()
  turtle.select(1)

  turtle.turnLeft(); turtle.turnLeft() -- face back to exit again
  return ok
end

-- --------- NO TORCHES HANDLER ------------
local function handleNoTorchesAtMain(st, reason)
  st.mode = "WAIT_TORCHES"
  st.phase = "WAIT_TORCHES"
  st.sideStage = ""
  st.sideStep = 0
  saveState(st)

  log("Keine Fackeln mehr (" .. reason .. "). Fahre zum Start, entlade, stoppe.")
  goHome(st.mainSteps)
  unloadToBackChestOrStop(st)

  st.mode = "WAIT_TORCHES"
  st.phase = "WAIT_TORCHES"
  saveState(st)

  error("Keine Fackeln mehr. Bitte Slot 16 auffüllen und Script neu starten.")
end

local function ensureTorchesOrStop(st, reason)
  if turtle.getItemCount(TORCH_SLOT) > 0 then return end
  handleNoTorchesAtMain(st, reason)
end

-- ----------- SIDE TUNNEL -----------------
local function sideTunnel(dir, st) -- dir: "R" or "L"
  -- enter side
  if dir == "R" then turtle.turnRight() else turtle.turnLeft() end

  for i=1,SIDE_LEN do
    ensureFuel()
    step2High()
    st.sideStep = i
    saveState(st)
  end

  -- torch at end; if no torches now: return to main first, then go home+unload+stop
  st.phase = "SIDES_TORCH"
  saveState(st)

  if turtle.getItemCount(TORCH_SLOT) <= 0 then
    -- back out safely to main without placing torch
    turtle.turnLeft(); turtle.turnLeft()
    for i=1,SIDE_LEN do
      ensureFuel()
      forward()
    end
    turtle.turnLeft(); turtle.turnLeft()
    if dir == "R" then turtle.turnLeft() else turtle.turnRight() end -- face main again (reverse of entry)
    -- Now we're back on main line facing forward; handle no torches fully.
    handleNoTorchesAtMain(st, "Seitenfackel fehlt")
  end

  local okTorch = placeTorchAtSideEnd()
  if not okTorch then
    -- Extremely rare: placement blocked; treat as "no torches / cannot place"
    -- We are currently facing back (exit) and already moved 1 back inside placeTorchAtSideEnd()
    -- Return remaining and then go home+stop.
    for i=1,(SIDE_LEN - 1) do
      ensureFuel()
      forward()
    end
    if dir == "R" then turtle.turnLeft() else turtle.turnRight() end
    handleNoTorchesAtMain(st, "Fackel konnte nicht platziert werden")
  end

  -- Now facing back, already moved 1 back; return remaining
  st.phase = "SIDES_RETURN"
  saveState(st)

  for i=1,(SIDE_LEN - 1) do
    ensureFuel()
    forward()
  end

  -- Now at main entrance, facing towards main corridor.
  -- Face main forward direction again:
  if dir == "R" then turtle.turnRight() else turtle.turnLeft() end

  st.sideStep = 0
  saveState(st)
end

-- --------------- MAIN --------------------
local function parseLengthArg()
  if arg and (arg[1] == "reset" or arg[2] == "reset") then
    resetState()
    log("State reset.")
    return nil, "reset_done"
  end
  local n = nil
  if arg and arg[1] then n = tonumber(arg[1]) end
  if not n then n = DEFAULT_LENGTH end
  return n, nil
end

local function run()
  local length, special = parseLengthArg()
  if special == "reset_done" then return end

  local st = migrateState(loadState() or { mode="MAIN", mainSteps=0, phase="MAIN", sideStep=0, sideStage="" })

  -- If chest was full, retry unloading first
  if st.mode == "WAIT_CHEST_FULL" then
    log("WAIT_CHEST_FULL aktiv -> versuche erneut zu entladen...")
    unloadToBackChestOrStop(st)
    st.mode = "MAIN"
    st.phase = "MAIN"
    saveState(st)
    log("Entladen ok. Fahre zurück zur Arbeitsposition...")
    goBackToWork(st.mainSteps)
  end

  -- If we were waiting for torches: only continue if torches exist now
  if st.mode == "WAIT_TORCHES" then
    if turtle.getItemCount(TORCH_SLOT) <= 0 then
      error("STOP: Immer noch keine Fackeln in Slot 16. Bitte auffüllen und erneut starten.")
    end
    log("Fackeln wieder vorhanden -> entlade zur Sicherheit und fahre zurück zur Arbeitsposition...")
    unloadToBackChestOrStop(st)
    st.mode = "MAIN"
    st.phase = "MAIN"
    saveState(st)
    goBackToWork(st.mainSteps)
  end

  log("Start/Resume mainSteps=" .. st.mainSteps .. " / target=" .. length)

  while st.mainSteps < length do
    ensureFuel()

    -- unload only if full
    if isInventoryFull() then
      st.mode = "UNLOADING"
      saveState(st)

      log("Inventar voll -> Heimweg")
      goHome(st.mainSteps)

      unloadToBackChestOrStop(st)

      st.mode = "MAIN"
      st.phase = "MAIN"
      saveState(st)

      log("Zurück zur Arbeit")
      goBackToWork(st.mainSteps)
    end

    -- side tunnels every 3 blocks of main tunnel (resume-safe stage)
    if (st.mainSteps > 0) and (st.mainSteps % SIDE_EVERY == 0) then
      -- Before doing sides, ensure we still have torches.
      ensureTorchesOrStop(st, "vor Abzweigung")

      st.phase = "SIDES"
      if st.sideStage == "" then st.sideStage = "R" end
      saveState(st)

      if st.sideStage == "R" then
        st.sideStep = 0
        saveState(st)
        sideTunnel("R", st)
        st.sideStage = "L"
        saveState(st)
      end

      if st.sideStage == "L" then
        st.sideStep = 0
        saveState(st)
        sideTunnel("L", st)
        st.sideStage = ""
        st.phase = "MAIN"
        saveState(st)
      end
    end

    -- main forward step
    st.mode = "MAIN"
    st.phase = "MAIN"
    st.sideStage = ""
    st.sideStep = 0
    saveState(st)

    step2High()
    st.mainSteps = st.mainSteps + 1
    saveState(st)
  end

  st.mode = "DONE"
  saveState(st)
  log("Fertig.")
end

local ok, err = pcall(run)
if not ok then
  log("STOP: " .. tostring(err))
end

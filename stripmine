-- stripmine (CC:Tweaked / ATM10) - FINAL (post-sides checks only)
-- 2-high main tunnel. Every 3 blocks: side tunnels right+left, 5 long, 2-high.
-- Torch attempt at end of each side (ignore placement failure).
-- NO auto-refuel.
-- NEW: Only after finishing BOTH side tunnels, check:
--      - inventory full -> go home, unload, return
--      - torches <= 2   -> go home, unload, STOP (wait for refill)
-- Resume-safe side stages (prevents double-right).

-- ================= CONFIG =================
local DEFAULT_LENGTH = 500
local SIDE_EVERY = 3
local SIDE_LEN   = 5

local TORCH_SLOT = 16
local TORCH_MIN  = 2   -- must be >2 to continue; <=2 triggers go home + unload + stop

local STATE_FILE = "stripmine_state"
-- =========================================

local function log(msg) print("[StripMine] " .. msg) end

-- --------------- STATE -------------------
local function saveState(st)
  local h = fs.open(STATE_FILE, "w")
  h.write(textutils.serialize(st))
  h.close()
end

local function loadState()
  if not fs.exists(STATE_FILE) then return nil end
  local h = fs.open(STATE_FILE, "r")
  local t = textutils.unserialize(h.readAll())
  h.close()
  if type(t) ~= "table" then return nil end
  return t
end

local function resetState()
  if fs.exists(STATE_FILE) then fs.delete(STATE_FILE) end
end

local function migrateState(st)
  if st.mainSteps == nil and type(st.main) == "number" then st.mainSteps = st.main end
  if type(st.mainSteps) ~= "number" then st.mainSteps = 0 end
  if st.mode == nil then st.mode = "MAIN" end
  if st.phase == nil then st.phase = "MAIN" end
  if type(st.sideStep) ~= "number" then st.sideStep = 0 end
  if st.sideStage == nil then st.sideStage = "" end -- "" / "R" / "L"
  return st
end

-- ------------- DIG / MOVE ----------------
local function digForward()
  while turtle.detect() do
    turtle.dig()
    sleep(0.05)
  end
end

local function digUp()
  while turtle.detectUp() do
    turtle.digUp()
    sleep(0.05)
  end
end

local function forward()
  digForward()
  while not turtle.forward() do
    turtle.attack()
    sleep(0.05)
    digForward()
  end
end

local function step2High()
  digForward()
  digUp()
  forward()
  digUp()
end

-- --------------- FUEL --------------------
local function ensureFuel()
  local f = turtle.getFuelLevel()
  if f == "unlimited" then return end
  if f <= 0 then
    error("Fuel ist leer. Ich stoppe. (Kein Auto-Refuel aktiv)")
  end
end

-- ----------- INVENTORY -------------------
local function isInventoryFullFast()
  for i=1,16 do
    if turtle.getItemCount(i) == 0 then return false end
  end
  return true
end

-- ---------- HOME MOVE (main line) --------
local function goHome(stepsFromStart)
  -- assumes turtle is on main line facing forward direction
  turtle.turnLeft(); turtle.turnLeft()
  for i=1,stepsFromStart do
    ensureFuel()
    forward()
  end
  turtle.turnLeft(); turtle.turnLeft()
end

local function goBackToWork(stepsFromStart)
  for i=1,stepsFromStart do
    ensureFuel()
    step2High()
  end
end

-- ---------- UNLOAD (chest behind start) ---
local function unloadToBackChestOrStop(st)
  log("Entladen in Kiste hinter Start...")

  turtle.turnLeft(); turtle.turnLeft() -- face chest behind start

  local failed = false
  for i=1,16 do
    if turtle.getItemCount(i) > 0 and i ~= TORCH_SLOT then
      turtle.select(i)
      local ok = turtle.drop()
      if (not ok) and turtle.getItemCount(i) > 0 then
        failed = true
      end
    end
  end

  turtle.select(1)
  turtle.turnLeft(); turtle.turnLeft() -- face forward again

  if failed then
    st.mode = "WAIT_CHEST_FULL"
    saveState(st)
    error("Kiste voll/blockiert: Entladen nicht vollständig. Ich bleibe am Start stehen.")
  end
end

-- -------------- TORCH --------------------
local function tryPlaceTorchAtSideEndIgnoreFail()
  if turtle.getItemCount(TORCH_SLOT) <= 0 then return false end

  -- Try "wall torch": turn around, step 1 back, face end direction, place(); ignore failure.
  turtle.turnLeft(); turtle.turnLeft()
  forward()
  turtle.turnLeft(); turtle.turnLeft()

  turtle.select(TORCH_SLOT)
  local ok = turtle.place()
  turtle.select(1)

  turtle.turnLeft(); turtle.turnLeft() -- face back to exit again
  return ok
end

-- ----------- SIDE TUNNEL -----------------
local function sideTunnel(dir, st) -- dir: "R" or "L"
  if dir == "R" then turtle.turnRight() else turtle.turnLeft() end

  for i=1,SIDE_LEN do
    ensureFuel()
    step2High()
    st.sideStep = i
    saveState(st)
  end

  st.phase = "SIDES_TORCH"
  saveState(st)
  tryPlaceTorchAtSideEndIgnoreFail()

  st.phase = "SIDES_RETURN"
  saveState(st)
  for i=1,(SIDE_LEN - 1) do
    ensureFuel()
    forward()
  end

  -- face main forward again
  if dir == "R" then turtle.turnRight() else turtle.turnLeft() end

  st.sideStep = 0
  saveState(st)
end

-- --------- POST-SIDES CHECKS -------------
local function afterSidesChecks(st)
  -- Check inventory full AFTER both sides
  if isInventoryFullFast() then
    st.mode = "UNLOADING"
    st.phase = "POST_SIDES_UNLOAD"
    saveState(st)

    log("Nach Seitengängen: Inventar voll -> Heimweg")
    goHome(st.mainSteps)

    unloadToBackChestOrStop(st)

    st.mode = "MAIN"
    st.phase = "MAIN"
    saveState(st)

    log("Zurück zur Arbeit")
    goBackToWork(st.mainSteps)
  end

  -- Check torches AFTER both sides
  local tc = turtle.getItemCount(TORCH_SLOT)
  if tc <= TORCH_MIN then
    st.mode = "WAIT_TORCHES"
    st.phase = "POST_SIDES_TORCH_STOP"
    saveState(st)

    log("Nach Seitengängen: Fackeln niedrig (" .. tc .. "). Heimweg, entladen, STOP.")
    goHome(st.mainSteps)
    unloadToBackChestOrStop(st)

    st.mode = "WAIT_TORCHES"
    st.phase = "WAIT_TORCHES"
    saveState(st)

    error("Fackeln <= " .. TORCH_MIN .. " in Slot 16. Bitte auffüllen und neu starten.")
  end
end

-- --------------- MAIN --------------------
local function parseLengthArg()
  if arg and (arg[1] == "reset" or arg[2] == "reset") then
    resetState()
    log("State reset.")
    return nil, "reset_done"
  end
  local n = nil
  if arg and arg[1] then n = tonumber(arg[1]) end
  if not n then n = DEFAULT_LENGTH end
  return n, nil
end

local function run()
  local length, special = parseLengthArg()
  if special == "reset_done" then return end

  local st = migrateState(loadState() or { mode="MAIN", mainSteps=0, phase="MAIN", sideStep=0, sideStage="" })

  -- Resume handling: chest full
  if st.mode == "WAIT_CHEST_FULL" then
    log("WAIT_CHEST_FULL aktiv -> versuche erneut zu entladen...")
    unloadToBackChestOrStop(st)
    st.mode = "MAIN"; st.phase = "MAIN"
    saveState(st)
    log("Entladen ok. Fahre zurück zur Arbeitsposition...")
    goBackToWork(st.mainSteps)
  end

  -- Resume handling: waiting torches
  if st.mode == "WAIT_TORCHES" then
    local tc = turtle.getItemCount(TORCH_SLOT)
    if tc <= TORCH_MIN then
      error("STOP: Fackeln noch zu niedrig (" .. tc .. "). Bitte Slot 16 auffüllen und erneut starten.")
    end
    log("Fackeln wieder ausreichend (" .. tc .. ") -> entlade zur Sicherheit und fahre zurück...")
    unloadToBackChestOrStop(st)
    st.mode = "MAIN"; st.phase = "MAIN"
    saveState(st)
    goBackToWork(st.mainSteps)
  end

  log("Start/Resume mainSteps=" .. st.mainSteps .. " / target=" .. length)

  while st.mainSteps < length do
    ensureFuel()

    -- SIDE BRANCH POINT
    if (st.mainSteps > 0) and (st.mainSteps % SIDE_EVERY == 0) then
      st.phase = "SIDES"
      if st.sideStage == "" then st.sideStage = "R" end
      saveState(st)

      if st.sideStage == "R" then
        st.sideStep = 0; saveState(st)
        sideTunnel("R", st)
        st.sideStage = "L"; saveState(st)
      end

      if st.sideStage == "L" then
        st.sideStep = 0; saveState(st)
        sideTunnel("L", st)
        st.sideStage = ""
        st.phase = "MAIN"
        saveState(st)
      end

      -- ✅ YOUR REQUEST: checks happen AFTER both side tunnels
      afterSidesChecks(st)
    end

    -- main forward step
    st.mode = "MAIN"
    st.phase = "MAIN"
    st.sideStage = ""
    st.sideStep = 0
    saveState(st)

    step2High()
    st.mainSteps = st.mainSteps + 1
    saveState(st)
  end

  st.mode = "DONE"
  saveState(st)
  log("Fertig.")
end

local ok, err = pcall(run)
if not ok then
  log("STOP: " .. tostring(err))
end

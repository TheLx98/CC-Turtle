-- stripmine - FAST CHECKS, NO STACKING, STABLE TORCH PRECHECK
local DEFAULT_LENGTH = 500
local SIDE_EVERY = 3
local SIDE_LEN   = 5

local TORCH_SLOT = 16
local TORCH_MIN  = 2

local STATE_FILE = "stripmine_state"

local function log(msg) print("[StripMine] " .. msg) end

-- state
local function saveState(st)
  local h = fs.open(STATE_FILE, "w")
  h.write(textutils.serialize(st))
  h.close()
end

local function loadState()
  if not fs.exists(STATE_FILE) then return nil end
  local h = fs.open(STATE_FILE, "r")
  local t = textutils.unserialize(h.readAll())
  h.close()
  return type(t) == "table" and t or nil
end

local function resetState()
  if fs.exists(STATE_FILE) then fs.delete(STATE_FILE) end
end

local function migrateState(st)
  if st.mainSteps == nil and type(st.main) == "number" then st.mainSteps = st.main end
  if type(st.mainSteps) ~= "number" then st.mainSteps = 0 end
  if st.mode == nil then st.mode = "MAIN" end
  if st.phase == nil then st.phase = "MAIN" end
  if type(st.sideStep) ~= "number" then st.sideStep = 0 end
  if st.sideStage == nil then st.sideStage = "" end
  return st
end

-- dig/move
local function digForward()
  while turtle.detect() do turtle.dig(); sleep(0.05) end
end

local function digUp()
  while turtle.detectUp() do turtle.digUp(); sleep(0.05) end
end

local function forward()
  digForward()
  while not turtle.forward() do
    turtle.attack()
    sleep(0.05)
    digForward()
  end
end

local function step2High()
  digForward(); digUp(); forward(); digUp()
end

-- fuel (no auto refuel)
local function ensureFuel()
  local f = turtle.getFuelLevel()
  if f == "unlimited" then return end
  if f <= 0 then error("Fuel ist leer. Ich stoppe. (Kein Auto-Refuel)") end
end

-- fast checks
local function isInventoryFullFast()
  for i=1,16 do
    if turtle.getItemCount(i) == 0 then return false end
  end
  return true
end

local function torchesEnough()
  return turtle.getItemCount(TORCH_SLOT) > TORCH_MIN
end

-- home/back (assumes main line facing forward)
local function goHome(stepsFromStart)
  turtle.turnLeft(); turtle.turnLeft()
  for i=1,stepsFromStart do ensureFuel(); forward() end
  turtle.turnLeft(); turtle.turnLeft()
end

local function goBackToWork(stepsFromStart)
  for i=1,stepsFromStart do ensureFuel(); step2High() end
end

-- unload (chest behind start)
local function unloadToBackChestOrStop(st)
  log("Entladen in Kiste hinter Start...")
  turtle.turnLeft(); turtle.turnLeft()

  local failed = false
  for i=1,16 do
    if turtle.getItemCount(i) > 0 and i ~= TORCH_SLOT then
      turtle.select(i)
      local ok = turtle.drop()
      if (not ok) and turtle.getItemCount(i) > 0 then failed = true end
    end
  end
  turtle.select(1)
  turtle.turnLeft(); turtle.turnLeft()

  if failed then
    st.mode = "WAIT_CHEST_FULL"
    saveState(st)
    error("Kiste voll/blockiert: Entladen nicht vollständig. Stop am Start.")
  end
end

local function goHomeUnloadReturn(st)
  st.mode = "UNLOADING"; saveState(st)
  goHome(st.mainSteps)
  unloadToBackChestOrStop(st)
  st.mode = "MAIN"; st.phase = "MAIN"; saveState(st)
  goBackToWork(st.mainSteps)
end

local function goHomeUnloadStopTorches(st)
  st.mode = "WAIT_TORCHES"; st.phase = "WAIT_TORCHES"; st.sideStage = ""; st.sideStep = 0
  saveState(st)
  goHome(st.mainSteps)
  unloadToBackChestOrStop(st)
  st.mode = "WAIT_TORCHES"; st.phase = "WAIT_TORCHES"; saveState(st)
  error("Fackeln <= " .. TORCH_MIN .. " in Slot 16. Bitte auffüllen und neu starten.")
end

-- torch attempt end of side (ignore fail)
local function tryPlaceTorchAtSideEndIgnoreFail()
  if turtle.getItemCount(TORCH_SLOT) <= 0 then return false end
  turtle.turnLeft(); turtle.turnLeft()
  forward()
  turtle.turnLeft(); turtle.turnLeft()
  turtle.select(TORCH_SLOT)
  local ok = turtle.place()
  turtle.select(1)
  turtle.turnLeft(); turtle.turnLeft()
  return ok
end

local function sideTunnel(dir, st)
  if dir == "R" then turtle.turnRight() else turtle.turnLeft() end

  for i=1,SIDE_LEN do
    ensureFuel()
    step2High()
    st.sideStep = i
    saveState(st)
  end

  st.phase = "SIDES_TORCH"; saveState(st)
  tryPlaceTorchAtSideEndIgnoreFail()

  st.phase = "SIDES_RETURN"; saveState(st)
  for i=1,(SIDE_LEN - 1) do ensureFuel(); forward() end

  if dir == "R" then turtle.turnRight() else turtle.turnLeft() end
  st.sideStep = 0
  saveState(st)
end

local function parseLengthArg()
  if arg and (arg[1] == "reset" or arg[2] == "reset") then
    resetState()
    log("State reset.")
    return nil, "reset_done"
  end
  local n = (arg and arg[1]) and tonumber(arg[1]) or nil
  if not n then n = DEFAULT_LENGTH end
  return n, nil
end

local function run()
  local length, special = parseLengthArg()
  if special == "reset_done" then return end

  local st = migrateState(loadState() or { mode="MAIN", mainSteps=0, phase="MAIN", sideStep=0, sideStage="" })

  -- resume: chest full
  if st.mode == "WAIT_CHEST_FULL" then
    unloadToBackChestOrStop(st)
    st.mode = "MAIN"; st.phase = "MAIN"; saveState(st)
    goBackToWork(st.mainSteps)
  end

  -- resume: torches
  if st.mode == "WAIT_TORCHES" then
    if not torchesEnough() then
      error("STOP: Fackeln noch zu niedrig. Bitte Slot 16 auffüllen.")
    end
    unloadToBackChestOrStop(st)
    st.mode = "MAIN"; st.phase = "MAIN"; saveState(st)
    goBackToWork(st.mainSteps)
  end

  log("Start/Resume mainSteps=" .. st.mainSteps .. " / target=" .. length)

  while st.mainSteps < length do
    ensureFuel()

    -- ✅ Fast inventory check (cheap) after each main step cycle
    if isInventoryFullFast() then
      log("Inventar voll -> Heim/Entladen")
      goHomeUnloadReturn(st)
    end

    -- side point
    if (st.mainSteps > 0) and (st.mainSteps % SIDE_EVERY == 0) then
      -- ✅ torch precheck to prevent "fly out of mountain"
      if not torchesEnough() then
        log("Fackeln niedrig vor Seitengängen -> Heim/Entladen/STOP")
        goHomeUnloadStopTorches(st)
      end

      st.phase = "SIDES"
      if st.sideStage == "" then st.sideStage = "R" end
      saveState(st)

      if st.sideStage == "R" then
        sideTunnel("R", st)
        st.sideStage = "L"
        saveState(st)
      end

      if st.sideStage == "L" then
        sideTunnel("L", st)
        st.sideStage = ""
        st.phase = "MAIN"
        saveState(st)
      end
    end

    -- main forward step
    st.mode = "MAIN"; st.phase = "MAIN"; st.sideStage = ""; st.sideStep = 0
    saveState(st)

    step2High()
    st.mainSteps = st.mainSteps + 1
    saveState(st)
  end

  st.mode = "DONE"
  saveState(st)
  log("Fertig.")
end

local ok, err = pcall(run)
if not ok then log("STOP: " .. tostring(err)) end

-- stripmine (CC:Tweaked / ATM10) - FINAL
-- Main tunnel 2-high. Every 3 blocks: side tunnels right+left, 5 long, 2-high.
-- Torch at END of each side tunnel (reliable placement).
-- Auto-refuel. If inventory full: return to start and unload to chest BEHIND start orientation.
-- If chest is full/blocking: STOP and wait (rerun after you fix chest).
-- Saves progress to disk and can resume; migrates older state keys.

-- ================= CONFIG =================
local DEFAULT_LENGTH = 500
local SIDE_EVERY = 3
local SIDE_LEN   = 5

local TORCH_SLOT = 16
local FUEL_SLOT  = 15 -- optional safe slot, not unloaded

local STATE_FILE = "stripmine_state"
-- =========================================

local function log(msg) print("[StripMine] " .. msg) end

-- --------------- STATE -------------------
local function saveState(st)
  local h = fs.open(STATE_FILE, "w")
  h.write(textutils.serialize(st))
  h.close()
end

local function loadState()
  if not fs.exists(STATE_FILE) then return nil end
  local h = fs.open(STATE_FILE, "r")
  local t = textutils.unserialize(h.readAll())
  h.close()
  if type(t) ~= "table" then return nil end
  return t
end

local function resetState()
  if fs.exists(STATE_FILE) then fs.delete(STATE_FILE) end
end

local function migrateState(st)
  -- Handle older versions that used 'main' instead of 'mainSteps'
  if st.mainSteps == nil and type(st.main) == "number" then
    st.mainSteps = st.main
  end
  if type(st.mainSteps) ~= "number" then st.mainSteps = 0 end
  if st.mode == nil then st.mode = "MAIN" end
  if st.phase == nil then st.phase = "MAIN" end
  if st.sideDir == nil then st.sideDir = "" end
  if type(st.sideStep) ~= "number" then st.sideStep = 0 end
  return st
end

-- ------------- DIG / MOVE ----------------
local function digForward()
  while turtle.detect() do
    turtle.dig()
    sleep(0.05)
  end
end

local function digUp()
  while turtle.detectUp() do
    turtle.digUp()
    sleep(0.05)
  end
end

local function forward()
  digForward()
  while not turtle.forward() do
    turtle.attack()
    sleep(0.05)
    digForward()
  end
end

local function step2High()
  -- clears front + headspace, moves, clears headspace at new cell
  digForward()
  digUp()
  forward()
  digUp()
end

-- --------------- FUEL --------------------
local function tryRefuelFromSlot(slot)
  if turtle.getItemCount(slot) <= 0 then return false end
  turtle.select(slot)
  if turtle.refuel(0) then
    turtle.refuel(64)
    turtle.select(1)
    return (turtle.getFuelLevel() == "unlimited") or (turtle.getFuelLevel() > 0)
  end
  turtle.select(1)
  return false
end

local function ensureFuel()
  local f = turtle.getFuelLevel()
  if f == "unlimited" then return end
  if f > 0 then return end

  -- prefer dedicated fuel slot
  if tryRefuelFromSlot(FUEL_SLOT) then return end

  -- then try all slots except torches
  for i=1,16 do
    if i ~= TORCH_SLOT and tryRefuelFromSlot(i) then return end
  end

  error("Fuel leer und kein Refuel-Material gefunden. Bitte Fuel nachlegen.")
end

-- -------------- TORCH --------------------
local function placeTorchAtSideEnd()
  -- Reliable method:
  -- At end of side tunnel, you're facing a SOLID wall block.
  -- You cannot place into a solid block. So:
  -- 1) turn around and step 1 back
  -- 2) turn back to the end wall
  -- 3) place() into the air block in front (the end cell), attached to the wall
  -- 4) turn around again to continue returning
  if turtle.getItemCount(TORCH_SLOT) <= 0 then
    log("Keine Fackeln in Slot " .. TORCH_SLOT .. "!")
    return false
  end

  turtle.turnLeft(); turtle.turnLeft() -- face back toward exit
  forward()                             -- step 1 back from the end wall
  turtle.turnLeft(); turtle.turnLeft() -- face end wall again

  turtle.select(TORCH_SLOT)
  local ok = turtle.place()
  turtle.select(1)

  turtle.turnLeft(); turtle.turnLeft() -- face back to exit
  return ok
end

-- ----------- INVENTORY -------------------
local function compactInventory()
  for i=1,16 do
    if turtle.getItemCount(i) > 0 then
      turtle.select(i)
      for j=i+1,16 do
        if turtle.getItemCount(j) > 0 then
          turtle.select(j)
          turtle.transferTo(i)
        end
      end
    end
  end
  turtle.select(1)
end

local function isInventoryFull()
  compactInventory()
  for i=1,16 do
    if turtle.getItemCount(i) == 0 then return false end
  end
  return true
end

local function unloadToBackChestOrStop(st)
  -- At start facing forward, chest is behind start orientation.
  -- Turn around and drop forward into the chest.
  log("Entladen in Kiste hinter Start...")

  turtle.turnLeft(); turtle.turnLeft()

  local failed = false
  for i=1,16 do
    if turtle.getItemCount(i) > 0 and i ~= TORCH_SLOT and i ~= FUEL_SLOT then
      turtle.select(i)
      local ok = turtle.drop()
      if (not ok) and turtle.getItemCount(i) > 0 then
        failed = true
      end
    end
  end

  turtle.select(1)
  turtle.turnLeft(); turtle.turnLeft()

  if failed then
    st.mode = "WAIT_CHEST_FULL"
    saveState(st)
    error("Kiste voll/blockiert: Entladen nicht vollständig. Ich bleibe am Start stehen.")
  end
end

local function goHome(stepsFromStart)
  turtle.turnLeft(); turtle.turnLeft()
  for i=1,stepsFromStart do
    ensureFuel()
    forward()
  end
  turtle.turnLeft(); turtle.turnLeft()
end

local function goBackToWork(stepsFromStart)
  for i=1,stepsFromStart do
    ensureFuel()
    step2High()
  end
end

-- ----------- SIDE TUNNEL -----------------
local function sideTunnel(dir, st) -- dir: "R" or "L"
  if dir == "R" then turtle.turnRight() else turtle.turnLeft() end

  -- dig in
  for i=1,SIDE_LEN do
    ensureFuel()
    step2High()
    st.sideStep = i
    saveState(st)
  end

  -- torch at end (reliable)
  st.phase = "TORCH"
  saveState(st)
  placeTorchAtSideEnd()

  -- Now we are facing back toward the exit and already moved 1 step back.
  -- Return remaining (SIDE_LEN - 1) steps to the main tunnel.
  st.phase = "RETURN"
  saveState(st)

  for i=1,(SIDE_LEN - 1) do
    ensureFuel()
    forward()
  end

  -- face main direction again
  if dir == "R" then turtle.turnLeft() else turtle.turnRight() end

  st.sideStep = 0
  saveState(st)
end

-- --------------- MAIN --------------------
local function parseLengthArg()
  -- supports: stripmine 500
  -- supports: stripmine reset
  if arg and (arg[1] == "reset" or arg[2] == "reset") then
    resetState()
    log("State reset.")
    return nil, "reset_done"
  end

  local n = nil
  if arg and arg[1] then n = tonumber(arg[1]) end
  if not n then n = DEFAULT_LENGTH end
  return n, nil
end

local function run()
  local length, special = parseLengthArg()
  if special == "reset_done" then return end

  local st = loadState()
  st = migrateState(st or { mode="MAIN", mainSteps=0, phase="MAIN", sideDir="", sideStep=0 })

  -- If chest was full, try unloading again first
  if st.mode == "WAIT_CHEST_FULL" then
    log("WAIT_CHEST_FULL aktiv -> versuche erneut zu entladen...")
    unloadToBackChestOrStop(st)
    st.mode = "MAIN"
    saveState(st)
    log("Entladen ok. Fahre zurück zur Arbeitsposition...")
    goBackToWork(st.mainSteps)
  end

  log("Start/Resume bei mainSteps=" .. st.mainSteps .. " / target=" .. length)

  while st.mainSteps < length do
    ensureFuel()

    -- unload only if FULL
    if isInventoryFull() then
      st.mode = "UNLOADING"
      saveState(st)

      log("Inventar voll -> Heimweg")
      goHome(st.mainSteps)

      unloadToBackChestOrStop(st)

      st.mode = "MAIN"
      saveState(st)

      log("Zurück zur Arbeit")
      goBackToWork(st.mainSteps)
    end

    -- main step
    st.phase = "MAIN"
    st.sideDir = ""
    st.sideStep = 0
    saveState(st)

    step2High()
    st.mainSteps = st.mainSteps + 1
    saveState(st)

    -- side tunnels every 3 blocks of main tunnel
    if (st.mainSteps % SIDE_EVERY) == 0 then
      st.phase = "SIDES"
      saveState(st)

      st.sideDir = "R"; st.sideStep = 0; saveState(st)
      sideTunnel("R", st)

      st.sideDir = "L"; st.sideStep = 0; saveState(st)
      sideTunnel("L", st)

      st.sideDir = ""; st.sideStep = 0
      st.phase = "MAIN"
      saveState(st)
    end
  end

  st.mode = "DONE"
  saveState(st)
  log("Fertig.")
end

local ok, err = pcall(run)
if not ok then
  log("STOP: " .. tostring(err))
end
